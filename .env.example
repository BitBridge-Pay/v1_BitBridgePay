# =============================================================================
# BitBridge Pay — environment variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Starknet
# -----------------------------------------------------------------------------

# RPC endpoint for the target network.
# BlastAPI has shut down. Recommended free providers:
#   Alchemy (free tier, sign up at alchemy.com):
#     Sepolia:  https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/<API_KEY>
#     Mainnet:  https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/<API_KEY>
#   Infura (free tier, sign up at infura.io):
#     Sepolia:  https://starknet-sepolia.infura.io/v3/<API_KEY>
STARKNET_RPC_URL=

# Network identifier used by starknet.js ("SN_SEPOLIA" | "SN_MAIN")
STARKNET_NETWORK=SN_SEPOLIA

# Deployed BitBridgePay contract address on the target network
CONTRACT_ADDRESS=

# Attestor account — the Starknet account that submits attestations.
# This key must match the attestor address used at contract deploy time.
ATTESTOR_ADDRESS=
ATTESTOR_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Bitcoin
# -----------------------------------------------------------------------------

# "mainnet" | "testnet" | "testnet4"
BITCOIN_NETWORK=testnet

# Blockstream API base URL (no trailing slash)
# Testnet: https://blockstream.info/testnet/api
# Mainnet: https://blockstream.info/api
BLOCKSTREAM_API_URL=https://blockstream.info/testnet/api

# Minimum confirmations before submitting an attestation
# 1 for testnet; 3 for mainnet
BTC_MIN_CONFIRMATIONS=1

# -----------------------------------------------------------------------------
# Relayer runtime
# -----------------------------------------------------------------------------

# How often (ms) to poll Starknet for new PaymentCreated events
POLL_INTERVAL_MS=30000

# How often (ms) to poll Blockstream for BTC confirmations on watched payments
BTC_POLL_INTERVAL_MS=60000

# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
